# ---- Supabase (Project Settings -> API) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role...
# The anon key is public and is also placed in assets/config.js for the browser.
SUPABASE_ANON_KEY=eyJ...anon...

# ---- App security ----
# Password gate. Both "vanta" and "VANTA" work (case-insensitive).
DESK_PASSWORD=vanta
# Any long random string. Signs the login cookie.
SESSION_SECRET=change-me-to-a-long-random-string
# Long random string. The Stage URL is /stage?k=<STAGE_KEY>
STAGE_KEY=change-me-to-another-long-random-string

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=123456789:ABC...
# Random string you also pass to setWebhook as secret_token
TELEGRAM_WEBHOOK_SECRET=change-me
# Comma-separated numeric Telegram user IDs allowed to control the show (you + 19Keys).
# Leave empty on first deploy: the bot replies to any message with the sender's ID so you can copy it here.
TELEGRAM_ALLOWED_IDS=

# ---- Claude (conversational producer commands over Telegram) ----
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5
# Optional cheaper model just for the auto headline/summary (falls back to CLAUDE_MODEL)
CLAUDE_SUMMARY_MODEL=

# ---- Screenshot capture ----
# Leave blank to use Microlink's free tier (no key, ~25 captures/day).
# For higher volume/reliability, add a ScreenshotOne access key (stores images in the Supabase 'shots' bucket).
SCREENSHOTONE_ACCESS_KEY=

# ---- Optional ----
# Public base URL of the deployment, used in Telegram replies (no trailing slash)
PUBLIC_BASE_URL=https://rundown.highlvldaily.com
